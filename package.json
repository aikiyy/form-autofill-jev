{
  "name": "form-autofill-jev",
  "version": "0.1.0",
  "description": "Webフォームにプロフィールを自動入力するChrome拡張",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "spike": "node --env-file=.env scripts/jev-spike.ts",
    "fixtures": "python3 -m http.server 8765 --directory test/fixtures/forms",
    "icons": "node scripts/build-icons.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
